---
import {
  getCollection,
  getEntry,
  type CollectionEntry,
  type CollectionKey,
} from "astro:content";

type PageData = {
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  draft?: boolean;
};

export const getSinglePage = async <C extends CollectionKey>(
  collectionName: C
): Promise<CollectionEntry<C>[]> => {
  const buildDrafts = process.argv.includes("--buildDrafts");
  const buildFuture = process.argv.includes("--buildFuture");
  const now = new Date();

  const allPages = await getCollection(
    collectionName,
    ({ data, id }) => {
      if (!buildDrafts && (data as PageData)?.draft) {
        return false;
      }
      if (!buildFuture && (data as any)?.date) {
        const postDate = new Date((data as any).date);
        if (postDate > now) {
          return false;
        }
      }
      return !id.startsWith("-");
    }
  );
  return allPages;
};

// fetch and merge entries from one or several collections, e.g. when a
// listing (categories/tags/authors) needs to span both `blog` (podcast
// episodes) and `posts` (the general blog)
export const getSinglePages = async <C extends CollectionKey>(
  collectionNames: C | C[]
): Promise<CollectionEntry<C>[]> => {
  const names = Array.isArray(collectionNames)
    ? collectionNames
    : [collectionNames];
  const pages = await Promise.all(names.map((name) => getSinglePage(name)));
  return pages.flat();
};

export const getListPage = async <C extends CollectionKey>(
  collectionName: C,
  documentId: "-index" | string
): Promise<CollectionEntry<C>> => {
  const data = (await getEntry(
    collectionName,
    documentId
  )) as CollectionEntry<C> | null;

  if (!data) {
    throw new Error(
      `No page found for the collection: ${collectionName} with filename: ${documentId}`
    );
  }

  return data;
};
---
