---
import Icon from "@/components/Icon.astro";
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";

// Countries represented in the community, ported from the hero on the old
// homepage (template/index_hero.html).
const flags =
  "🇦🇷 🇧🇴 🇨🇱 🇨🇴 🇨🇷 🇨🇺 🇪🇨 🇸🇻 🇪🇸 🇬🇹 🇬🇶 🇭🇳 🇲🇽 🇳🇮 🇵🇦 🇵🇾 🇵🇪 🇵🇷 🇩🇴 🇺🇾 🇻🇪";

const homepage = await getListPage("homepage", "-index");

const { banner, features } = homepage.data;

const highlights = [
  {
    title: "Ayuda cuando la necesitas",
    text: "Pregunta tus dudas de Python, sea cual sea tu nivel, y recibe respuestas de otras personas de la comunidad.",
    link: "/discord/",
    label: "Cómo empezar",
  },
  {
    title: "Aprender en compañía",
    text: "Forma un equipo, construye un proyecto o súmate a un grupo de estudio.",
    link: "/aprende-python/",
    label: "Aprende construyendo",
  },
  {
    title: "Podcast y transmisiones",
    text: "Conversaciones con personas de la comunidad y actividades en vivo dentro del servidor.",
    link: "/podcast/",
    label: "Escuchar el podcast",
  },
  {
    title: "Ofertas y eventos",
    text: "Un espacio moderado para compartir oportunidades de trabajo y eventos de Python.",
    link: "/ofertas/",
    label: "Ver las normas",
  },
];

const initiatives = [
  {
    title: "PyLadies en Español",
    image: "/images/site/pyladies_en_espanol.png",
    link: "/pyladies/",
  },
  {
    title: "Podcast: Bit a bit",
    image: "/images/site/bit_a_bit.png",
    link: "/podcast/",
  },
  {
    title: "Aprende Python Construyendo",
    image: "/images/site/aprende_construyendo.png",
    link: "/aprende-python/",
  },
  {
    title: "Transmisiones",
    image: "/images/site/transmisiones.png",
    link: "/transmisiones/",
  },
];
---

<Base>
  <!-- Banner -->
  <section class="section pt-14">
    <div class="container">
      <div class="row items-center justify-center">
        {
          banner.image && (
            <div class="mb-8 text-center md:col-4 lg:col-4">
              <ImageMod
                src={banner.image}
                height={320}
                width={320}
                alt="banner"
                class="mx-auto"
                format="webp"
              />
            </div>
          )
        }
        <div class="mb-8 text-center md:col-8 lg:col-7">
          <h1
            set:html={markdownify(banner.title)}
            class="mb-4 text-h3 lg:text-h1"
          />
          <div class="mb-6 flex flex-wrap justify-center gap-3">
            {
              banner.button.enable && (
                <a
                  class="btn btn-primary"
                  href={banner.button.link}
                  target={
                    banner.button.link.startsWith("http") ? "_blank" : "_self"
                  }
                  rel="noopener"
                >
                  <Icon name="FaDiscord" className="mr-2 inline-block" />
                  {banner.button.label}
                </a>
              )
            }
            <a
              class="btn btn-outline-primary"
              href="https://t.me/PythonEsp"
              target="_blank"
              rel="noopener"
            >
              <Icon name="FaTelegram" className="mr-2 inline-block" />
              Telegram
            </a>
          </div>
          <p class="mb-6">
            <a class="underline" href="/discord/">¿Primera vez en Discord? Mira cómo empezar</a>
          </p>
          <p class="mb-6 text-lg">{flags}</p>
          <p set:html={markdownify(banner.content)} class="mb-8" />
        </div>
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Qué encontrarás -->
  <section class="section-sm">
    <div class="container">
      <h2 class="mb-10 text-center">Qué encontrarás aquí</h2>
      <div class="row justify-center">
        {
          highlights.map((item) => (
            <div class="mb-8 md:col-6 lg:col-3">
              <div class="flex h-full flex-col rounded-2xl bg-light p-6 dark:bg-darkmode-light">
                <h3 class="mb-3 text-xl">{item.title}</h3>
                <p class="mb-4">{item.text}</p>
                <a class="mt-auto font-semibold" href={item.link}>
                  {item.label}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /Qué encontrarás -->

  <!-- Features -->
  {
    features.map((feature, index: number) => (
      <section class={`section-sm ${index % 2 === 0 && "bg-primary/5"}`}>
        <div class="container">
          <div class="row items-center justify-between">
            <div
              class={`mb:md-0 mb-6 md:col-5 ${index % 2 !== 0 && "md:order-2"}`}
            >
              <ImageMod
                src={feature.image}
                height={480}
                width={520}
                alt={feature.title}
                format="webp"
              />
            </div>
            <div class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}>
              <h2 set:html={markdownify(feature.title)} class="mb-4" />
              <p set:html={markdownify(feature.content)} class="mb-8 text-lg" />
              <ul>
                {feature.bulletpoints.map((bullet: string) => (
                  <li class="relative mb-4 pl-6">
                    <Icon name="FaCheck" className="absolute left-0 top-1.5" />
                    <span
                      set:html={markdownify(bullet)}
                      class="[&_a]:text-link dark:[&_a]:text-darkmode-link [&_a]:hover:underline"
                    />
                  </li>
                ))}
              </ul>
              {feature.button.enable && (
                <a class="btn btn-primary mt-5" href={feature.button.link}>
                  {feature.button.label}
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    ))
  }
  <!-- /Features -->

  <!-- Sin comunidad cerca -->
  <section class="section-sm">
    <div class="container">
      <div class="rounded-2xl bg-light p-8 text-center dark:bg-darkmode-light md:p-12">
        <h2 class="mb-4">¿No tienes una comunidad cerca?</h2>
        <p class="mx-auto mb-8 max-w-2xl text-lg">
          Aquí puedes quedarte. Personas de muchos países se reúnen para aprender
          y ayudarse, estés donde estés. Y si quieres crear la comunidad de tu
          ciudad o país, te acompañamos.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href="/discord/">Cómo empezar en Discord</a>
          <a class="btn btn-outline-primary" href="/quienes-somos/">
            Quiénes somos
          </a>
          <a class="btn btn-outline-primary" href="/comienza-comunidad/">
            Comienza una comunidad
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- /Sin comunidad cerca -->

  <!-- Iniciativas -->
  <section class="section-sm">
    <div class="container">
      <h2 class="mb-10 text-center">Iniciativas</h2>
      <div class="row justify-center">
        {
          initiatives.map((initiative) => (
            <div class="mb-8 text-center md:col-6 lg:col-3">
              <div class="h-full rounded-2xl bg-light p-6 dark:bg-darkmode-light">
                <ImageMod
                  src={initiative.image}
                  height={120}
                  width={120}
                  alt={initiative.title}
                  class="mx-auto mb-4"
                  format="webp"
                />
                <p class="mb-4">{initiative.title}</p>
                <a class="btn btn-outline-primary btn-sm" href={initiative.link}>
                  Lee más
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /Iniciativas -->
</Base>
