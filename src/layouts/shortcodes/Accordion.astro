---
// Native, JS-light accordion (no React). Behavior comes from toggling the
// `.active` class on click; the actual open/close animation is pure CSS
// (see .accordion-content / .accordion.active in src/styles/components.css).
// Each accordion has an anchor id (the `id` prop, or a slug of the title) so
// a URL like /faq#some-question opens it directly.
import { slugify } from "@/lib/utils/textConverter";

export interface Props {
  title: string;
  id?: string;
  className?: string;
}

const { title, id, className } = Astro.props as Props;
const anchor = id ?? slugify(title);
---

<div id={anchor} class={`accordion ${className ?? ""}`}>
  <button type="button" class="accordion-header">
    {title}
    <svg
      class="accordion-icon"
      viewBox="0 0 512 512"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        fill="currentColor"
        d="M505.755,123.592c-8.341-8.341-21.824-8.341-30.165,0L256.005,343.176L36.421,123.592c-8.341-8.341-21.824-8.341-30.165,0 s-8.341,21.824,0,30.165l234.667,234.667c4.16,4.16,9.621,6.251,15.083,6.251c5.462,0,10.923-2.091,15.083-6.251l234.667-234.667 C514.096,145.416,514.096,131.933,505.755,123.592z"
      ></path>
    </svg>
  </button>
  <div class="accordion-content">
    <slot />
  </div>
</div>

<script>
  const accordions = document.querySelectorAll<HTMLElement>(".accordion");

  // open (and scroll to) the accordion named by the URL hash
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target?.classList.contains("accordion")) {
      target.classList.add("active");
      target.scrollIntoView({ block: "start" });
    }
  };

  accordions.forEach((accordion) => {
    accordion.querySelector(".accordion-header")?.addEventListener("click", () => {
      const open = accordion.classList.toggle("active");
      // keep the URL shareable: opening an item puts its anchor in the hash
      history.replaceState(
        null,
        "",
        open ? `#${accordion.id}` : location.pathname + location.search,
      );
    });
  });

  openFromHash();
  window.addEventListener("hashchange", openFromHash);
</script>
