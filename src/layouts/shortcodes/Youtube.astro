---
// Thin wrapper around the framework-agnostic <lite-youtube> web component
// (no React needed; the previous version only used React to lazy-load it).
export interface Props {
  id: string;
  title: string;
  className?: string;
}

const { id, title, className } = Astro.props as Props;
---

<div class="mx-auto my-8 w-full max-w-xl px-4 sm:px-8">
  <lite-youtube
    videoid={id}
    videotitle={title}
    class={`rounded-lg ${className ?? ""}`}
  ></lite-youtube>
</div>

<script>
  import("@justinribeiro/lite-youtube");
</script>
