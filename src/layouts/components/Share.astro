---
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  description?: string;
  url: string;
  className?: string;
}

const { title = "", description = "", url, className } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const d = encodeURIComponent(description);
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="botón para compartir en facebook"
      href={`https://facebook.com/sharer/sharer.php?u=${u}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <Icon name="IoLogoFacebook" />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="botón para compartir en X"
      href={`https://x.com/intent/post?text=${t}&url=${u}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <Icon name="IoLogoTwitter" />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="botón para compartir en linkedin"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${u}&title=${t}&summary=${d}&source=${encodeURIComponent(new URL(url).origin)}`}
      target="_blank"
      rel="noreferrer noopener"
    >
      <Icon name="IoLogoLinkedin" />
    </a>
  </li>
</ul>
