---
import BlogCard from "@/components/BlogCard.astro";
import Icon from "@/components/Icon.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import PostImage from "./components/PostImage.astro";

const { post } = Astro.props;

// look for related posts within the same collection as the current post
// (podcast episodes relate to other episodes, blog posts to other posts)
const posts = await getSinglePage(post.collection);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const { title, description, author, categories, image, date } = post.data;
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        <div class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-center">
          <PostImage
            src={image}
            height={320}
            width={320}
            alt={title}
            class="size-40 shrink-0 rounded"
            fit="cover"
          />
          <div>
            <h1 set:html={markdownify(title)} class="h2 mb-4" />
            <ul class="mb-4">
              <li class="mr-4 inline-block">
                <Icon name="FaRegUserCircle" className="mr-2 -mt-1 inline-block" />
        {humanize(author)}
              </li>
              <li class="mr-4 inline-block">
                <Icon name="FaRegFolder" className="mr-2 -mt-1 inline-block" />
                {
                  categories.map((category: string, index: number) => (
                    <a href={`/categories/${slugify(category)}/`}>
                      {humanize(category)}
                      {index !== categories.length - 1 && ","}
                    </a>
                  ))
                }
              </li>
              <li class="mr-4 inline-block">
                <Icon name="FaRegClock" className="mr-2 -mt-1 inline-block" />
                {dateFormat(date)}
              </li>
            </ul>
          </div>
        </div>
        <div class="content mb-10">
          <Content />
        </div>
        <div class="row items-start justify-between">
          <div class="flex items-center lg:col-4">
            <h5 class="mr-3">Compartir :</h5>
            <Share
              className="social-icons"
              title={title}
              description={description}
              url={new URL(Astro.url.pathname, config.site.base_url).href}
            />
          </div>
        </div>
      </article>
    </div>

    <!-- Related posts -->
    <div class="section pb-0">
      <h2 class="h3 mb-12 text-center">Posts relacionados</h2>
      <div class="row justify-center">
        {
          similarPosts.map((post) => (
            <div class="lg:col-4 md:col-6 mb-14">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
