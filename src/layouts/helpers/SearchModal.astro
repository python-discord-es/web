---
// Vanilla-JS site search (no React). Static shell here; all the behavior
// lives in the <script> tag below, which imports the search index generated
// by scripts/jsonGenerator.js (now covering pages/posts/blog, not just the
// podcast) and mirrors the same match-highlighting/keyboard-nav logic the
// previous React version had.
---

<div id="searchModal" class="search-modal">
  <div id="searchModalOverlay" class="search-modal-overlay"></div>
  <div class="search-wrapper">
    <div class="search-wrapper-header">
      <label for="searchInput" class="absolute left-7 top-[calc(50%-7px)]">
        <span class="sr-only">icono de búsqueda</span>
        <svg
          id="searchIconSearch"
          viewBox="0 0 512 512"
          height="18"
          width="18"
          class="-mt-0.5"
        >
          <title>icono de búsqueda</title>
          <path
            fill="currentcolor"
            d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8.0 45.3s-32.8 12.5-45.3.0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9.0 208S93.1.0 208 0 416 93.1 416 208zM208 352a144 144 0 100-288 144 144 0 100 288z"
          ></path>
        </svg>
        <svg
          id="searchIconClose"
          viewBox="0 0 512 512"
          height="18"
          width="18"
          class="hidden hover:text-red-500 cursor-pointer -mt-0.5"
        >
          <title>icono de cerrar</title>
          <path
            fill="currentcolor"
            d="M256 512A256 256 0 10256 0a256 256 0 100 512zM175 175c9.4-9.4 24.6-9.4 33.9.0l47 47 47-47c9.4-9.4 24.6-9.4 33.9.0s9.4 24.6.0 33.9l-47 47 47 47c9.4 9.4 9.4 24.6.0 33.9s-24.6 9.4-33.9.0l-47-47-47 47c-9.4 9.4-24.6 9.4-33.9.0s-9.4-24.6.0-33.9l47-47-47-47c-9.4-9.4-9.4-24.6.0-33.9z"
          ></path>
        </svg>
      </label>
      <input
        id="searchInput"
        placeholder="Buscar..."
        class="search-wrapper-header-input"
        type="input"
        name="search"
        autocomplete="off"
      />
    </div>
    <div id="searchResultsBody" class="search-wrapper-body">
      <div class="py-8 text-center">Escribe algo para buscar...</div>
    </div>
    <div class="search-wrapper-footer">
      <span class="flex items-center">
        <kbd>
          <svg width="14" height="14" fill="currentcolor" viewBox="0 0 16 16">
            <path d="M3.204 11h9.592L8 5.519 3.204 11zm-.753-.659 4.796-5.48a1 1 0 011.506.0l4.796 5.48c.566.647.106 1.659-.753 1.659H3.204a1 1 0 01-.753-1.659z"
            ></path>
          </svg>
        </kbd>
        <kbd>
          <svg width="14" height="14" fill="currentcolor" viewBox="0 0 16 16">
            <path d="M3.204 5h9.592L8 10.481 3.204 5zm-.753.659 4.796 5.48a1 1 0 001.506.0l4.796-5.48c.566-.647.106-1.659-.753-1.659H3.204a1 1 0 00-.753 1.659z"
            ></path>
          </svg>
        </kbd>
        para navegar
      </span>
      <span class="flex items-center">
        <kbd>
          <svg width="12" height="12" fill="currentcolor" viewBox="0 0 16 16">
            <path
              fill-rule="evenodd"
              d="M14.5 1.5a.5.5.0 01.5.5v4.8a2.5 2.5.0 01-2.5 2.5H2.707l3.347 3.346a.5.5.0 01-.708.708l-4.2-4.2a.5.5.0 010-.708l4-4a.5.5.0 11.708.708L2.707 8.3H12.5A1.5 1.5.0 0014 6.8V2a.5.5.0 01.5-.5z"
            ></path>
          </svg>
        </kbd>
        para seleccionar
      </span>
      <span id="searchResultsMeta"></span>
      <span><kbd>ESC</kbd> para cerrar</span>
    </div>
  </div>
</div>

<script>
  import { plainify, titleify } from "@/lib/utils/textConverter";
  import searchData from "../../../.json/search.json";

  interface SearchItem {
    group: string;
    slug: string;
    frontmatter: {
      title: string;
      image?: string;
      description?: string;
      categories?: string[];
      tags?: string[];
    };
    content: string;
  }

  const escapeHtml = (text: string) =>
    text.replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c] as string,
    );

  // wrap matches of `substring` in `text` with the given tag/class, after
  // HTML-escaping the surrounding text
  const highlight = (
    text: string,
    substring: string,
    wrap: (part: string) => string,
  ) => {
    if (!text) return "";
    const parts = text.split(new RegExp(`(${substring})`, "gi"));
    return parts
      .map((part) =>
        part.toLowerCase() === substring.toLowerCase()
          ? wrap(escapeHtml(part))
          : escapeHtml(part),
      )
      .join("");
  };

  const matchMarker = (text: string, substring: string) =>
    highlight(text, substring, (part) => `<mark>${part}</mark>`);

  const matchUnderline = (text: string, substring: string) =>
    highlight(text, substring, (part) => `<span class="underline">${part}</span>`);

  const matchContent = (content: string, substring: string) => {
    const plainContent = plainify(content);
    const position = plainContent.toLowerCase().indexOf(substring.toLowerCase());
    if (position === -1) return escapeHtml(plainContent.slice(0, 80));

    let wordStart = position;
    while (wordStart > 0 && plainContent[wordStart - 1] !== " ") {
      wordStart--;
    }

    const matches = plainContent.substring(wordStart, substring.length + position);
    const matchesAfter = plainContent.substring(
      substring.length + position,
      substring.length + position + 80,
    );
    return `${matchMarker(matches, substring)}${escapeHtml(matchesAfter)}`;
  };

  const doSearch = (searchString: string): SearchItem[] => {
    if (!searchString) return [];
    const regex = new RegExp(searchString, "gi");
    return (searchData as SearchItem[]).filter((item) => {
      const title = item.frontmatter.title?.toLowerCase().match(regex);
      const description = item.frontmatter.description?.toLowerCase().match(regex);
      const categories = item.frontmatter.categories?.join(" ").toLowerCase().match(regex);
      const tags = item.frontmatter.tags?.join(" ").toLowerCase().match(regex);
      const content = item.content?.toLowerCase().match(regex);
      return Boolean(title || content || description || categories || tags);
    });
  };

  const groupByCollection = (results: SearchItem[]) => {
    const groups: { group: string; items: SearchItem[] }[] = [];
    results.forEach((item) => {
      let group = groups.find((g) => g.group === item.group);
      if (!group) {
        group = { group: item.group, items: [] };
        groups.push(group);
      }
      group.items.push(item);
    });
    return groups;
  };

  const renderItem = (item: SearchItem, searchString: string) => `
    <div id="searchItem" class="search-result-item">
      ${
        item.frontmatter.image
          ? `<div class="search-result-item-image"><img src="${item.frontmatter.image}" alt="${escapeHtml(item.frontmatter.title)}" /></div>`
          : ""
      }
      <div class="search-result-item-body">
        <a href="/${item.slug}" class="search-result-item-title search-result-item-link">
          ${matchUnderline(item.frontmatter.title, searchString)}
        </a>
        ${
          item.frontmatter.description
            ? `<p class="search-result-item-description">${matchUnderline(item.frontmatter.description, searchString)}</p>`
            : ""
        }
        ${
          item.content
            ? `<p class="search-result-item-content">${matchContent(item.content, searchString)}</p>`
            : ""
        }
        <div class="search-result-item-taxonomies">
          ${
            item.frontmatter.categories?.length
              ? `<div class="mr-2"><svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M11 0H3a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2 2 2 0 0 0 2-2V4a2 2 0 0 0-2-2 2 2 0 0 0-2-2zm2 3a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1V3zM2 2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2z"></path></svg>${item.frontmatter.categories
                  .map((c) => matchUnderline(c, searchString))
                  .join(", ")}</div>`
              : ""
          }
          ${
            item.frontmatter.tags?.length
              ? `<div class="mr-2"><svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M3 2v4.586l7 7L14.586 9l-7-7H3zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2z"></path><path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1zm0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1v5.086z"></path></svg>${item.frontmatter.tags
                  .map((t) => matchUnderline(t, searchString))
                  .join(", ")}</div>`
              : ""
          }
        </div>
      </div>
    </div>`;

  const noResultsSvg = `<svg class="mx-auto" width="42" height="42" viewBox="0 0 47 47" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.10368 33.9625C9.90104 36.2184 13.2988 37.6547 16.9158 38.0692C21.6958 38.617 26.5063 37.3401 30.3853 34.4939C30.4731 34.6109 30.5668 34.7221 30.6721 34.8304L41.9815 46.1397C42.5323 46.6909 43.2795 47.0007 44.0587 47.001C44.838 47.0013 45.5854 46.692 46.1366 46.1412C46.6878 45.5904 46.9976 44.8432 46.9979 44.064C46.9981 43.2847 46.6888 42.5373 46.138 41.9861L34.8287 30.6767C34.7236 30.5704 34.6107 30.4752 34.4909 30.3859C37.3352 26.5046 38.6092 21.6924 38.0579 16.912C37.6355 13.2498 36.1657 9.81322 33.8586 6.9977L31.7805 9.09214C34.0157 11.9274 35.2487 15.4472 35.2487 19.0942C35.2487 21.2158 34.8308 23.3167 34.0189 25.2769C33.207 27.2371 32.0169 29.0181 30.5167 30.5184C29.0164 32.0186 27.2354 33.2087 25.2752 34.0206C23.315 34.8325 21.2141 35.2504 19.0925 35.2504C16.9708 35.2504 14.8699 34.8325 12.9098 34.0206C11.5762 33.4682 10.3256 32.7409 9.18992 31.8599L7.10368 33.9625ZM28.9344 6.28152C26.1272 4.12516 22.671 2.93792 19.0925 2.93792C14.8076 2.93792 10.6982 4.64009 7.66829 7.66997C4.6384 10.6999 2.93623 14.8093 2.93623 19.0942C2.93623 21.2158 3.35413 23.3167 4.16605 25.2769C4.72475 26.6257 5.4625 27.8897 6.35716 29.0358L4.2702 31.1391C1.35261 27.548 -0.165546 23.0135 0.00974294 18.3781C0.19158 13.5695 2.18233 9.00695 5.58371 5.60313C8.98509 2.19932 13.5463 0.205307 18.3547 0.0200301C22.9447 -0.156832 27.4369 1.32691 31.0132 4.18636L28.9344 6.28152Z" fill="currentColor"></path><path d="M3.13672 39.1367L38.3537 3.64355" stroke="black" stroke-width="3" stroke-linecap="round"></path></svg>`;

  const render = (searchString: string) => {
    const body = document.getElementById("searchResultsBody")!;
    const meta = document.getElementById("searchResultsMeta")!;

    if (!searchString) {
      body.innerHTML = `<div class="py-8 text-center">Escribe algo para buscar...</div>`;
      meta.innerHTML = "";
      return;
    }

    const start = performance.now();
    const results = doSearch(searchString);
    const totalTime = ((performance.now() - start) / 1000).toFixed(3);

    if (results.length === 0) {
      body.innerHTML = `
        <div class="search-result">
          <div class="search-result-empty">
            ${noResultsSvg}
            <p class="mt-4">Sin resultados para "<strong>${escapeHtml(searchString)}</strong>"</p>
          </div>
        </div>`;
    } else {
      const groups = groupByCollection(results);
      body.innerHTML = `<div class="search-result">${groups
        .map(
          (g) => `
        <div class="search-result-group">
          <p class="search-result-group-title">${escapeHtml(titleify(g.group))}</p>
          ${g.items.map((item) => renderItem(item, searchString)).join("")}
        </div>`,
        )
        .join("")}</div>`;
    }

    meta.innerHTML = `<strong>${results.length} </strong> resultados - en <strong>${totalTime} </strong> segundos`;
  };

  const searchModal = document.getElementById("searchModal")!;
  const searchInput = document.getElementById("searchInput") as HTMLInputElement;
  const searchModalOverlay = document.getElementById("searchModalOverlay")!;
  const searchIconSearch = document.getElementById("searchIconSearch")!;
  const searchIconClose = document.getElementById("searchIconClose")!;

  const openModal = () => {
    searchModal.classList.add("show");
    searchInput.focus();
  };
  const closeModal = () => searchModal.classList.remove("show");

  document
    .querySelectorAll("[data-search-trigger]")
    .forEach((button) => button.addEventListener("click", openModal));
  searchModalOverlay.addEventListener("click", closeModal);

  searchIconClose.addEventListener("click", () => {
    searchInput.value = "";
    searchInput.dispatchEvent(new Event("input"));
    searchInput.focus();
  });

  searchInput.addEventListener("input", () => {
    const value = searchInput.value.replace("\\", "").toLowerCase();
    searchIconSearch.classList.toggle("hidden", Boolean(value));
    searchIconClose.classList.toggle("hidden", !value);
    selectedIndex = -1;
    render(value);
  });

  // keyboard navigation
  let selectedIndex = -1;

  const updateSelection = () => {
    const items = document.querySelectorAll("#searchItem");
    items.forEach((item, index) => {
      item.classList.toggle("search-result-item-active", index === selectedIndex);
    });
    items[selectedIndex]?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  };

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === "k") {
      event.preventDefault();
      openModal();
      updateSelection();
    }

    if (!searchModal.classList.contains("show")) return;

    if (event.key === "ArrowUp" || event.key === "ArrowDown") {
      event.preventDefault();
    }

    if (event.key === "Escape") {
      closeModal();
    }

    const items = document.querySelectorAll("#searchItem");
    if (event.key === "ArrowUp" && selectedIndex > 0) {
      selectedIndex--;
    } else if (event.key === "ArrowDown" && selectedIndex < items.length - 1) {
      selectedIndex++;
    } else if (event.key === "Enter") {
      const activeLink = document.querySelector(
        ".search-result-item-active a",
      ) as HTMLAnchorElement | null;
      activeLink?.click();
    }

    updateSelection();
  });
</script>
